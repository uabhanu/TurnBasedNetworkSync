root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf

[*.cs]
dotnet_analyzer_diagnostic.severity = none # https://github.com/JetBrains/resharper-unity/issues/2481
csharp_using_directive_placement = inside_namespace:warning
resharper_csharp_using_directive_placement = inside_namespace
resharper_csharp_optimize_usings = true

# Suppress Unity serialization analyzers on third-party vendor code
dotnet_diagnostic.UAC1002.severity = none
dotnet_diagnostic.UAC1009.severity = none
dotnet_diagnostic.uac1002.severity = none
dotnet_diagnostic.uac1009.severity = none